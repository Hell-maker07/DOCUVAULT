# Names only - copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000

# PostgreSQL (Neon in production, add ?sslmode=require)
DATABASE_URL=postgres://user:password@localhost:5432/docuvault_dev
# Separate database for tests; MUST differ from DATABASE_URL
DATABASE_URL_TEST=postgres://user:password@localhost:5432/docuvault_test

# Added in later steps (kept here so the contract is visible)
# JWT_SECRET=            # Step 3: signs login tokens (HS256, 1 hour)
# KEY_ENC_SECRET=        # Step 7: encrypts users' Ed25519 private keys (AES-256-GCM)
# STORAGE_URL= STORAGE_KEY= STORAGE_BUCKET=   # Step 4: file store
# MAX_UPLOAD_MB=         # Step 4: upload size limit
