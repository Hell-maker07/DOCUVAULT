# Names only - copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000

# PostgreSQL (Neon in production, add ?sslmode=require)
DATABASE_URL=postgres://user:password@localhost:5432/docuvault_dev
# Separate database for tests; MUST differ from DATABASE_URL
DATABASE_URL_TEST=postgres://user:password@localhost:5432/docuvault_test

# Authentication & Cryptography
JWT_SECRET=              # Step 3: signs login tokens (HS256, 1 hour)
# KEY_ENC_SECRET=        # Step 7: encrypts users' Ed25519 private keys (AES-256-GCM)

# Step 4: Storage driver ('local', 'swift', or 'supabase')
STORAGE_DRIVER=local
MAX_UPLOAD_MB=20
STORAGE_LOCAL_DIR=.storage_vault

# OpenStack Swift (when STORAGE_DRIVER=swift)
SWIFT_AUTH_URL=https://identity.example.com/v3
SWIFT_USERNAME=swift_user
SWIFT_PASSWORD=swift_secret
SWIFT_PROJECT_NAME=docuvault_project
SWIFT_PROJECT_DOMAIN_NAME=Default
SWIFT_USER_DOMAIN_NAME=Default
SWIFT_CONTAINER=docuvault
# Or direct storage endpoint with pre-authenticated token:
# SWIFT_STORAGE_URL=https://swift.example.com/v1/AUTH_tenant
# SWIFT_AUTH_TOKEN=gAAAAAB...

# Supabase Storage (when STORAGE_DRIVER=supabase)
# STORAGE_URL=https://xyzcompany.supabase.co
# STORAGE_KEY=eyJh...
# STORAGE_BUCKET=docuvault
